exports[`zos-jobs view all-spool-content command syntax errors should occur if the jobid is missing 1`] = `
"
Syntax Error:
Missing Positional Argument: jobid
Argument Description: The z/OS JOBID of the job containing the spool files you want to view. No
pre-validation of the JOBID is performed.

Example:

 - View all spool files for the job with job ID JOB00234:

      $ zowe zos-jobs view all-spool-content JOB00234

Use \\"zowe zos-jobs view all-spool-content --help\\" to view command description, usage, and options.
"
`;
