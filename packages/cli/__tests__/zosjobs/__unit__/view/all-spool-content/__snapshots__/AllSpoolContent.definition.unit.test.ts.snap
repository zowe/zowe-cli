exports[`zos-jobs view all-spool-content definition should not have changed 1`] = `
Object {
  "aliases": Array [
    "asc",
  ],
  "description": "View the contents of each spool file from a z/OS job on spool/JES queues. The command does not pre-validate the JOBID. The command presents errors verbatim from the z/OSMF Jobs REST endpoints.",
  "examples": Array [
    Object {
      "description": "View all spool files for the job with job ID JOB00234",
      "options": "JOB00234",
    },
  ],
  "name": "all-spool-content",
  "options": Array [
    Object {
      "aliases": Array [
        "ec",
      ],
      "description": "Download the spool file content with encoding mode, which means that data conversion is performed using the file encoding specified.",
      "name": "encoding",
      "type": "string",
    },
    Object {
      "description": "The maximum size, in bytes, of the content of each spool file to hold in memory and display. The command fails if the content of a spool file is larger. Increase this value to view larger spool files. Default: 67108864 (64 MiB).",
      "name": "max-response-bytes",
      "numericValueRange": Array [
        1,
        9007199254740991,
      ],
      "type": "number",
    },
  ],
  "positionals": Array [
    Object {
      "description": "The z/OS JOBID of the job containing the spool files you want to view. No pre-validation of the JOBID is performed.",
      "name": "jobid",
      "required": true,
      "type": "string",
    },
  ],
  "profile": Object {
    "optional": Array [
      "zosmf",
    ],
  },
  "summary": "View all spool content for a specified job ID",
  "type": "command",
}
`;
